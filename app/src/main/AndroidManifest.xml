<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-feature android:name="android.hardware.type.watch" />

    <application
        android:allowBackup="true"
        android:hardwareAccelerated="true"
        android:icon="@mipmap/ic_launcher_faceplate"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_faceplate_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <!-- Launcher:The only one that should have taskAffinity if any -->
        <activity
            android:name=".LauncherActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" /></intent-filter>
        </activity>

        <!-- All other activities: Removed taskAffinity so they stayin ONE stack -->
        <activity android:name=".Menu" android:exported="false" />
        <activity android:name=".HeiseiRiders1" android:exported="false" />
        <activity android:name=".HeiseiRiders2" android:exported="false" />
        <activity android:name=".ReiwaRiders1" android:exported="false" />
        <activity android:name=".Showa" android:exported="false" />
        <activity android:name=".Ohma" android:exported="false" />
        <activity android:name=".Gozyuger" android:exported="false" />
        <activity android:name=".MainActivity" android:exported="true" />

        <uses-library
            android:name="com.google.android.wearable"
            android:required="true" />

        <meta-data
            android:name="com.google.android.wearable.standalone"
            android:value="true" /></application>

</manifest>